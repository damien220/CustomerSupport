# .env.example — copy to .env and fill in real values; never commit .env

# ═════════════════════════════════════════════════════════════════════════════
# LLM ACCESS MODE — pick ONE of the three sections below (plan.md §2)
# ═════════════════════════════════════════════════════════════════════════════
#   api      this server calls an LLM provider with your key (default)
#   client   no LLM here: the calling agent's model (e.g. a Claude / ChatGPT
#            subscriber's chat app over MCP) writes replies from search_kb passages
#   offline  local LLM + local embedder/reranker; startup refuses any non-local
#            endpoint (LLM, embedder, reranker, Langfuse, ingest URLs)
LLM_MODE=api

# ── Section A: LLM_MODE=api ──────────────────────────────────────────────────
# LLM_PROVIDER selects a preset (faq_core/llm/presets.py). Blank LLM_MODEL /
# LLM_BASE_URL / LLM_MAX_TOKENS use the preset's values; set them to override.
#
#   LLM_PROVIDER  default model               key setting
#   anthropic     claude-opus-5-5             ANTHROPIC_API_KEY
#   openai        gpt-6-astra                 LLM_API_KEY
#   gemini        gemini-3.8-flash            LLM_API_KEY  (OpenAI-compatible endpoint)
#   groq          llama-3.3-70b-versatile     LLM_API_KEY
#   openrouter    openrouter/auto             LLM_API_KEY
#   mistral / cohere / together (kept from earlier versions)    LLM_API_KEY
#   custom        (set LLM_BASE_URL + LLM_MODEL; any OpenAI-compatible server)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=0
LLM_TIMEOUT=60
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_API_KEY=
# Anthropic only: re-run a declined request on a fallback model (supported models)
ANTHROPIC_REFUSAL_FALLBACK=true

# ── Section B: LLM_MODE=client ───────────────────────────────────────────────
# No LLM settings or keys are needed. MCP exposes search_kb (passages +
# citations + confidence + handling_instructions); answer_question is not
# registered; search_faq returns generated=false with an empty answer.
# REST: POST /kb/search works, POST /answer returns 501.
# Chat-app subscribers (Claude custom connector, ChatGPT developer mode) reach
# this server over remote MCP: python app.py --mode mcp --transport http behind
# a public HTTPS URL, with the REMOTE ACCESS SECURITY settings below
# (docs/remote-mcp.md). ChatGPT needs AUTH_MODE=oauth.
# LLM_MODE=client

# ── Section C: LLM_MODE=offline ──────────────────────────────────────────────
# Unless you set them explicitly, offline mode uses LLM_PROVIDER=ollama,
# EMBED_PROVIDER=local and RERANKER=bge (the last two fall back to hashing /
# no reranking without requirements-rag.txt; models load from the local
# Hugging Face cache only — HF_HUB_OFFLINE=1 is set at startup).
# Local runtimes need LLM_MODEL = the model they have loaded:
#   ollama    http://localhost:11434/v1  (OLLAMA_BASE_URL;  `ollama pull <model>`)
#   vllm      http://localhost:8000/v1   (VLLM_BASE_URL;    `vllm serve <model>`)
#   llamacpp  http://127.0.0.1:9931/v1   (LLM_BASE_URL;     `llama-server -m <gguf>`)
#   lmstudio  http://localhost:1234/v1   (LMSTUDIO_BASE_URL; enable the local server)
# LLM_API_KEY is optional (sent as a bearer token when set, e.g. vllm --api-key).
# Allowed endpoints: loopback, localhost, unix sockets, plus the private hosts
# listed here (comma-separated; IP literals must be private). This also covers
# OAUTH_ISSUER / OAUTH_JWKS_URL. Offline mode cannot be hosted remotely: the
# HTTP surfaces must bind loopback (or a private IP listed here), and a public
# OAUTH_RESOURCE_URL or ALLOWED_HOSTS name is refused at startup.
# LLM_MODE=offline
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
OFFLINE_ALLOWED_HOSTS=
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ═════════════════════════════════════════════════════════════════════════════
# Retrieval (all modes)
# ═════════════════════════════════════════════════════════════════════════════
# Embedding (dense side of hybrid retrieval)
#   hashing (default)       torch-free lexical feature hashing; works everywhere
#   local                   sentence-transformers EMBED_MODEL (needs requirements-rag.txt;
#                           falls back to hashing with a warning when not installed).
#                           EMBED_MODEL=multilingual selects BAAI/bge-m3 (100+ languages,
#                           1024-dim; EMBED_DIM is ignored for local models), so
#                           questions in any language retrieve the same passages.
#   openai                  any OpenAI-compatible /embeddings API at EMBED_BASE_URL
#   ollama                  Ollama /embeddings at OLLAMA_BASE_URL
# Changing the embedder re-embeds the whole knowledge base at the next start.
# (Leave EMBED_PROVIDER / RERANKER commented out to get the offline defaults.)
EMBED_PROVIDER=hashing
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_DIM=384

# Vector store: sqlite-vec (inside DB_PATH) | none (BM25 keyword search only).
# If the sqlite-vec extension cannot load, retrieval falls back to BM25 only.
VECTOR_STORE=sqlite-vec

# Retrieval tuning + optional reranker (none | cohere | bge)
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATES=30
RETRIEVAL_DEDUPE_THRESHOLD=0.85
CHUNK_MAX_CHARS=1200
RERANKER=none
RERANK_MODEL=
RERANK_API_KEY=

# Ingestion limits (python app.py --mode ingest --source FILE|FOLDER|URL)
INGEST_MAX_BYTES=5000000
INGEST_URL_TIMEOUT=15

# Database
DB_PATH=./data/faq.db

# Scheduler — blank (default) keeps the re-index queue in memory (lost on
# restart). Set a SQLAlchemy URL for a persistent queue, e.g.:
#   SCHEDULER_DB_URL=sqlite+aiosqlite:///./data/scheduler.db
SCHEDULER_DB_URL=

# Answer cache — in-process, per worker (identical queries reuse an answer for CACHE_TTL s)
CACHE_TTL=300
CACHE_MAX_ENTRIES=1024

# ═════════════════════════════════════════════════════════════════════════════
# Support workflow (all modes) — confidence, escalation, privacy, knowledge gaps
# ═════════════════════════════════════════════════════════════════════════════
# Confidence: score >= ANSWER → answer; >= CAVEAT → answer_with_caveat; else
# escalate (no LLM answer is generated for escalate). Heuristic, not calibrated;
# tuned with the hashing embedder — re-check the similarity floor/ceiling after
# switching EMBED_PROVIDER (python -m pytest tests/test_confidence.py).
CONFIDENCE_ANSWER_THRESHOLD=0.55
CONFIDENCE_CAVEAT_THRESHOLD=0.30
CONFIDENCE_SIMILARITY_FLOOR=0.05
CONFIDENCE_SIMILARITY_CEILING=0.35
# Optional LLM self-check of each generated answer (api/offline only, one extra
# LLM call per answer; ignored in client mode)
CONFIDENCE_SELF_CHECK=false

# Escalation triggers: all | none | comma list of low_confidence,
# repeated_rephrase, frustration, pii, sensitive_topic
ESCALATION_TRIGGERS=all
# Comma-separated phrases; blank = built-in English lists (add other languages here)
ESCALATION_FRUSTRATION_TERMS=
ESCALATION_LEGAL_TERMS=
ESCALATION_MEDICAL_TERMS=
# Repeated rephrase: escalate when >= MIN_REPEATS of the session's last WINDOW
# queries are at least this similar to the new one (pass session_id to the tools)
ESCALATION_REPHRASE_SIMILARITY=0.5
ESCALATION_REPHRASE_MIN_REPEATS=2
ESCALATION_REPHRASE_WINDOW=5

# Escalation hand-off sink: log (default; packet stays in the escalations table)
# | webhook (signed JSON POST). The URL is configuration only — agents cannot set
# it. Receivers verify X-Support-Signature = "sha256=" + HMAC-SHA256(secret,
# "<X-Support-Timestamp>.<raw body>"). In LLM_MODE=offline the URL must be local.
ESCALATION_SINK=log
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=
ESCALATION_WEBHOOK_TIMEOUT=5
ESCALATION_WEBHOOK_MAX_RETRIES=2

# PII redaction of customer text before logs, storage, traces and the LLM:
# on (default) | off. The knowledge base itself is never redacted.
PII_REDACTION=on

# Knowledge gaps (list_knowledge_gaps / GET /knowledge-gaps)
GAP_CLUSTER_THRESHOLD=0.35
GAP_SCAN_LIMIT=1000

# Resolution metrics (GET /metrics/resolution, GET /reports/weekly-gaps,
# --mode report): max rows read per table (query_log, escalations, feedback) per
# computation — beyond it only the newest rows count and the result says
# *_scan_truncated=true — and how long a computed result is reused (seconds,
# 0 = no cache).
METRICS_ROW_LIMIT=20000
METRICS_CACHE_TTL=60

# Operator-only MCP tools (currently get_resolution_metrics). They expose
# aggregated customer questions (PII-redacted, but redaction misses names,
# addresses and order numbers): keep this OFF on any MCP server a
# customer-facing agent uses. The REST metrics routes stay available (API-key
# gated).
MCP_OPERATOR_TOOLS=false

# Observability — leave blank to disable tracing in dev
# (In LLM_MODE=offline, Langfuse is refused unless LANGFUSE_HOST is local.)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Alerting — off by default. When true, LLM circuit-breaker transitions are
# logged (CRITICAL when it opens) — see observability/alerting.py.
ALERTING_ENABLED=false

# ═════════════════════════════════════════════════════════════════════════════
# Server + REMOTE ACCESS SECURITY (REST/WebSocket and MCP over HTTP)
# ═════════════════════════════════════════════════════════════════════════════
# python app.py --mode api                     REST + WS on BIND_HOST:PORT
# python app.py --mode mcp --transport http    MCP at http://BIND_HOST:MCP_HTTP_PORT/mcp
# python app.py --mode mcp                     MCP over stdio — never authenticated
#                                              (the client launched the process)
# Both HTTP surfaces REQUIRE authentication on every route except GET /health
# and /.well-known/oauth-protected-resource*. They refuse to start (exit 2)
# when the AUTH_MODE settings are missing or unsafe. See docs/remote-mcp.md.
BIND_HOST=127.0.0.1
PORT=8000
MCP_HTTP_PORT=8001
GRADIO_PORT=7860

# AUTH_MODE:
#   token  static bearer keys from API_KEYS (single tenant) — default
#   oauth  OAuth 2.1 resource server: JWT access tokens issued by OAUTH_ISSUER for
#          audience OAUTH_RESOURCE_URL (needed for ChatGPT; recommended for Claude)
#   both   either of the above
#   none   NO authentication — refused unless bound to loopback with no public
#          ALLOWED_HOSTS / OAUTH_RESOURCE_URL; logs a warning on every start
AUTH_MODE=token

# Static keys: comma-separated name:token pairs. Tokens must be >= 32 URL-safe
# characters; generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send "Authorization: <scheme> <token>" with scheme Bearer. The name
# shows up in logs and keys the rate limit; the token never does.
API_KEYS=
# API_KEYS=crm:<generated-token>,widget:<another-generated-token>

# OAuth resource-server mode (AUTH_MODE=oauth|both). This server never issues
# tokens: use an external authorization server (Keycloak, Auth0, Entra ID, ...).
# OAUTH_ISSUER       must equal the tokens' "iss" claim exactly
# OAUTH_RESOURCE_URL this server's canonical MCP URL as users enter it in the
#                    client, e.g. https://mcp.example.com/mcp; tokens must carry
#                    it in "aud" (RFC 8707). Served in the RFC 9728 metadata.
# OAUTH_JWKS_URL     the issuer's JWKS (https unless local; no redirects followed)
# OAUTH_ALGORITHMS   asymmetric only (RS*, PS*, ES*, EdDSA); HS* and none are refused
OAUTH_ISSUER=
OAUTH_RESOURCE_URL=
OAUTH_JWKS_URL=
OAUTH_ALGORITHMS=RS256,ES256
OAUTH_REQUIRED_SCOPES=
OAUTH_CLOCK_SKEW=60
OAUTH_JWKS_CACHE_TTL=3600
OAUTH_JWKS_TIMEOUT=5

# Browser Origins allowed (scheme://host[:port], comma-separated, no wildcards).
# Requests without an Origin header (agents, curl) pass; any other Origin -> 403.
ALLOWED_ORIGINS=
# Host header allowlist (host or host:port). Loopback binds always accept
# localhost/127.0.0.1/[::1] and refuse every other Host (DNS-rebinding guard,
# 421). For a public deployment set your public host name, e.g. mcp.example.com.
ALLOWED_HOSTS=

# Per-key sliding-window rate limit (authenticated), and per-client-IP limit for
# open routes and failed sign-ins. 0 disables. Per process (in memory).
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_ANON_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Background
REINDEX_CONCURRENCY=2
LOG_LEVEL=INFO
